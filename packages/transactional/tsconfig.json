{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "Display": "Vite",
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": false,
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "ESNext",
    "noEmit": true,
    "skipLibCheck": false,
    "target": "ES2020",
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  }
}