        "parameters": [],
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "description": "A basic information about user. If the user is a athlete, the coachId is required.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignupModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return the userId create by the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/c7695b17-4bc8-4c49-8565-1639e29aedca"
                }
              }
            },
            "headers": {}
          },
          "400": {
