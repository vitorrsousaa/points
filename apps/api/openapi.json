                "schema": {
                  "$ref": "#/components/schemas/002267a6-9a35-467d-b36f-54e5e242c881"
                }
              }
            },
            "headers": {}
          },
          "422": {
            "description": "An error message when send invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
