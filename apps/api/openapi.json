        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ATHLETE",
                "COACH",
                "ADMIN"
