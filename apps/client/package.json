{
	"name": "client",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"lint": "biome lint --apply ./src",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"check": "biome check --apply ./src",
		"format": "biome format --write ./src",
		"test": "vitest run",
		"test:watch": "vitest run --watch"
	},
